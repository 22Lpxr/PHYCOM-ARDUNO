/*
  =============================================================================
  [PHYCOM EXAM] 4. โค้ดตรวจสอบปุ่มกด (Push Button)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  ปุ่มกดแบบ 2 ขา หรือ 4 ขา (Tactile Switch):
    - ขาฝั่งหนึ่งของปุ่มกด ---> ต่อเข้าช่อง Pin 2 บนบอร์ด Arduino
    - ขาอีกฝั่งของปุ่มกด   ---> ต่อเข้าช่อง GND บนบอร์ด Arduino

  💡 ทริคเกี่ยวกับโหมด INPUT_PULLUP:
  -----------------------------------------------------------------------------
  - โค้ดนี้ใช้ `pinMode(buttonPin, INPUT_PULLUP)` ซึ่งเปิดใช้งานตัวต้านทานดึงขึ้น (Pull-up)
    ภายในชิปไมโครคอนโทรลเลอร์ ทำให้ **ไม่ต้องต่อตัวต้านทานภายนอกเพิ่มเติมเลย**
  - ลอจิกการทำงาน:
      * เมื่อ "ปล่อยมือ" (ไม่กดปุ่ม): บอร์ดจะดึงขาไปที่ไฟ 5V อ่านได้สถานะ = HIGH (1)
      * เมื่อ "กดปุ่ม": ขาจะต่อลงกราวด์ อ่านได้สถานะ = LOW (0)

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. กด Upload โค้ดลงบอร์ด Arduino
  2. เปิด Serial Monitor ตั้ง Baud Rate เป็น 9600
  3. ขณะยังไม่ได้กดปุ่ม จะไม่มีข้อความซ้ำๆ รัวๆ โผล่มา
  4. เมื่อใช้นิ้วกดปุ่มลงไป:
       - หน้าจอจะพิมพ์ทันที: "[ BUTTON PRESSED! ] -> สถานะ LOW (0)"
  5. เมื่อปล่อยนิ้วออกจากปุ่ม:
       - หน้าจอจะพิมพ์ทันที: "[ BUTTON RELEASED ] -> สถานะ HIGH (1)"
  6. หากไม่ว่าจะกดหรือไม่กดก็ไม่ตอบสนอง:
       - เช็คขาของปุ่มบน Breadboard (หากเป็นปุ่มแบบ 4 ขา บางขาจะต่อถึงกันอยู่แล้ว ให้ต่อขาทแยงมุมกัน)
  =============================================================================
*/

const int buttonPin = 2;
int lastState = -1;

void setup() {
  Serial.begin(9600);
  pinMode(buttonPin, INPUT_PULLUP);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("     Push Button Diagnostic Test (Pin 2)  ");
  Serial.println("==========================================");
  Serial.println("พร้อมทดสอบ: ลองกดปุ่มดูสถานะบนหน้าจอ...");
}

void loop() {
  int currentState = digitalRead(buttonPin);

  // ตรวจจับการเปลี่ยนแปลงสถานะ (Change State Detection) เพื่อไม่ให้แสดงผลซ้ำรัวๆ
  if (currentState != lastState) {
    lastState = currentState;

    if (currentState == LOW) {
      Serial.println("[ BUTTON PRESSED! ] -> สถานะ LOW (0) (ปุ่มถูกกด)");
    } else {
      Serial.println("[ BUTTON RELEASED ] -> สถานะ HIGH (1) (ปล่อยปุ่ม)");
    }
  }

  delay(50); // หน่วงเวลา 50ms เพื่อป้องกันสัญญาณกระเด้งของหน้าสัมผัส (Debouncing)
}
