/*
  =============================================================================
  [PHYCOM EXAM] 3. โค้ดตรวจสอบเซ็นเซอร์ Ultrasonic (HC-SR04)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  เซ็นเซอร์ HC-SR04 มีขาทั้งหมด 4 ขา เรียงตามตัวอักษรที่พิมพ์บนบอร์ด:
    - ขาที่ 1: VCC   ---> ต่อเข้าช่อง 5V บนบอร์ด Arduino
    - ขาที่ 2: Trig  ---> ต่อเข้าช่อง Pin 9 บนบอร์ด Arduino
    - ขาที่ 3: Echo  ---> ต่อเข้าช่อง Pin 8 บนบอร์ด Arduino
    - ขาที่ 4: GND   ---> ต่อเข้าช่อง GND บนบอร์ด Arduino

  💡 หลักการทำงานของเซ็นเซอร์:
  -----------------------------------------------------------------------------
  - ขา Trig รับสัญญาณ HIGH 10 ไมโครวินาทีจาก Arduino เพื่อยิงคลื่นเสียงอัลตราโซนิกออกไป
  - เมื่อคลื่นสะท้อนวัตถุกลับมา ขา Echo จะส่งพัลส์ HIGH กลับมายังบอร์ด
  - โค้ดคำนวณระยะทางจากสูตร: ระยะทาง (cm) = (ระยะเวลา uS * 0.0343) / 2

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. กด Upload โค้ดลงบอร์ด Arduino
  2. เปิด Serial Monitor ตั้ง Baud Rate เป็น 9600
  3. นำฝ่ามือหรือสมุดมาวางไว้หน้าเซ็นเซอร์ที่ระยะประมาณ 10 cm, 20 cm, 30 cm
  4. ผลลัพธ์ที่ปกติ:
       - ตัวเลข Distance (cm) จะเปลี่ยนตามระยะของวัตถุตรงหน้า
       - ค่าวัดแม่นยำในช่วงประมาณ 2 cm ถึง 400 cm
  5. หากขึ้น "Warning: Out of range / No Echo" ตลอดเวลา:
       - ตรวจสอบสาย Trig (Pin 9) และ Echo (Pin 8) ว่าไม่ได้เสียบสลับกัน
       - ตรวจสอบว่าสายไฟ 5V และ GND เสียบแน่นหรือไม่
  =============================================================================
*/

const int trigPin = 9;
const int echoPin = 8;

void setup() {
  Serial.begin(9600);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("   HC-SR04 Ultrasonic Diagnostic Test     ");
  Serial.println("==========================================");
}

void loop() {
  // เคลียร์สัญญาณ Trig ให้เป็น LOW ก่อนส่งสัญญาณ
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  // ส่งสัญญาณ Trigger HIGH เป็นเวลา 10 ไมโครวินาที
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // อ่านสัญญาณ Echo ที่สะท้อนกลับมา (ตั้ง Timeout ไว้ 30,000 us หรือประมาณ 5 เมตร)
  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) {
    Serial.println("Warning: Out of range / No Echo (ไม่พบสัญญาณสะท้อน หรือวัตถุอยู่ไกลเกินไป)");
  } else {
    // ความเร็วเสียงในอากาศประมาณ 343 เมตร/วินาที หรือ 0.0343 cm/us
    // หาร 2 เนื่องจากคลื่นเดินทางไปและกลับ
    float distance = duration * 0.0343 / 2.0;

    Serial.print("Distance: ");
    Serial.print(distance, 1);
    Serial.println(" cm");
  }

  delay(500); // อ่านค่าทุก 0.5 วินาที
}
