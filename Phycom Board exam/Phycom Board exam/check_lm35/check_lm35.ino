/*
  =============================================================================
  [PHYCOM EXAM] 1. โค้ดตรวจสอบเซ็นเซอร์วัดอุณหภูมิ (LM35 Temperature Sensor)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  1. หยิบเซ็นเซอร์ LM35 ขึ้นมา หัน "ด้านเรียบที่มีตัวหนังสือ LM35" เข้าหาตัวเรา
  2. จะมีขาทั้งหมด 3 ขา เรียงจาก ซ้าย ไป ขวา ดังนี้:
       - ขาที่ 1 (ซ้ายสุด)  ---> ต่อเข้าช่อง 5V บนบอร์ด Arduino
       - ขาที่ 2 (ตรงกลาง)   ---> ต่อเข้าช่อง A0 (Analog In) บนบอร์ด Arduino
       - ขาที่ 3 (ขวาสุด)   ---> ต่อเข้าช่อง GND บนบอร์ด Arduino

  ⚠️ ข้อควรระวังสูงสุด (Important Warning):
  -----------------------------------------------------------------------------
  - ห้ามต่อขากลับด้านเด็ดขาด (ห้ามต่อ 5V เข้าขาขวา หรือ GND เข้าขาซ้าย)
  - หากต่อผิด LM35 จะเกิดการลัดวงจร ตัวถังจะร้อนจัดจนลวกมือและชิปอาจไหม้ทันที!
  - แนะนำให้ใช้นิ้วสัมผัสตัวเซ็นเซอร์เบาๆ หลังเสียบไฟ ถ้าเริ่มอุ่นผิดปกติให้ถอดสายทันที

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. เสียบสาย USB และกด Upload โค้ดลงบอร์ด
  2. เปิด Serial Monitor (มุมขวาบนของ Arduino IDE)
  3. ตั้ง Baud Rate เป็น 9600
  4. ผลลัพธ์ที่ปกติ:
       - อุณหภูมิห้องทั่วไปจะอยู่ที่ประมาณ 25.0 °C ถึง 32.0 °C
       - เมื่อใช้นิ้วมือบีบจับที่ตัวเซ็นเซอร์ LM35 อุณหภูมิจะค่อยๆ เพิ่มขึ้นเป็น 33 - 36 °C
  5. หากค่าขึ้นเป็น 0.0 °C ตลอด หรือ 100+ °C:
       - ให้ตรวจเช็คสาย A0, 5V และ GND ว่าเสียบแน่นและตรงขาหรือไม่
  =============================================================================
*/

const int lm35Pin = A0;

void setup() {
  Serial.begin(9600);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("  LM35 Temperature Sensor Diagnostic Test ");
  Serial.println("==========================================");
}

void loop() {
  // อ่านค่าสัญญาณ Analog 10-bit จากขา A0 (ค่าดิบ 0 - 1023)
  int rawValue = analogRead(lm35Pin);

  // คำนวณแรงดันไฟฟ้า (Arduino Uno R4 ใช้ไฟเลี้ยง 5.0V)
  float voltage = rawValue * (5.0 / 1023.0);

  // แปลงแรงดันเป็นองศาเซลเซียส (LM35 ให้ 10 mV หรือ 0.01V ต่อ 1 °C)
  float temperatureC = voltage * 100.0;

  // แสดงผลลัพธ์ออกทาง Serial Monitor
  Serial.print("ADC Raw: ");
  Serial.print(rawValue);
  Serial.print(" | Voltage: ");
  Serial.print(voltage, 3);
  Serial.print(" V | Temperature: ");
  Serial.print(temperatureC, 1);
  Serial.println(" °C");

  delay(1000); // อ่านและแสดงผลทุกๆ 1 วินาที
}
