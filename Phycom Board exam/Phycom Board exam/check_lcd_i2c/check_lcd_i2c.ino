/*
  =============================================================================
  [PHYCOM EXAM] 7. โค้ดตรวจสอบจอแสดงผล Liquid Crystal Display (LCD 1602 I2C)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  จอ LCD 1602 พร้อมโมดูลแปลง I2C Backpack (บอร์ดสีดำหรือสีฟ้าที่ติดอยู่หลังจอ)
  มีสายเชื่อมต่อเพียง 4 เส้นเท่านั้น:
    - ขาที่ 1: GND  ---> ต่อเข้าช่อง GND บนบอร์ด Arduino
    - ขาที่ 2: VCC  ---> ต่อเข้าช่อง 5V บนบอร์ด Arduino
    - ขาที่ 3: SDA  ---> ต่อเข้าช่อง SDA (หรือช่อง Analog In A4) บนบอร์ด Arduino
    - ขาที่ 4: SCL  ---> ต่อเข้าช่อง SCL (หรือช่อง Analog In A5) บนบอร์ด Arduino

  📦 การติดตั้ง Library ในโปรแกรม Arduino IDE:
  -----------------------------------------------------------------------------
  1. ไปที่แถบเมนูด้านบน: Sketch -> Include Library -> Manage Libraries...
  2. ในช่องค้นหา พิมพ์ว่า: "LiquidCrystal I2C"
  3. เลือกติดตั้งเวอร์ชันของ "Frank de Brabander" หรือ "Marco Schwartz"

  ⚠️ ปัญหาที่พบบ่อยมากในการสอบ (Troubleshooting):
  -----------------------------------------------------------------------------
  1. หน้าจอมีไฟ Backlight ติด แต่ไม่เห็นตัวหนังสือเลย (ขึ้นเป็นช่องสี่เหลี่ยมทึบ หรือจางหาย):
       ---> แก้โดยใช้ไขควงแบนขนาดเล็กหมุนตัวต้านทานปรับค่าได้ (Potentiometer สีฟ้า)
            ที่อยู่ด้านหลังโมดูล I2C หมุนช้าๆ เพื่อปรับความเข้ม (Contrast) จนตัวอักษรคมชัด
  2. ข้อความไม่ออกเลยแม้จะปรับ Contrast แล้ว:
       ---> โมดูลบางยี่ห้อใช้ Address เป็น 0x3F แทนที่จะเป็น 0x27
            ให้ลองเปลี่ยนบรรทัด `LiquidCrystal_I2C lcd(0x27, 16, 2);`
            เป็น `LiquidCrystal_I2C lcd(0x3F, 16, 2);`

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. อัปโหลดโค้ดลงบอร์ด
  2. ผลลัพธ์บนหน้าจอ LCD:
       - บรรทัดที่ 1 จะขึ้นข้อความ: "PHYCOM EXAM TEST"
       - บรรทัดที่ 2 จะขึ้นข้อความ: "LCD OK! Sec: xx" โดยตัวเลข xx จะนับเพิ่มขึ้นเรื่อยๆ ทุก 1 วินาที
  =============================================================================
*/

#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// กำหนด Address (ปกติคือ 0x27 หรือ 0x3F) และขนาดจอ (16 ตัวอักษร, 2 บรรทัด)
LiquidCrystal_I2C lcd(0x27, 16, 2);

int counter = 0;

void setup() {
  Serial.begin(9600);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("      LCD 1602 (I2C) Diagnostic Test      ");
  Serial.println("==========================================");

  // เริ่มต้นการทำงานของจอ LCD
  lcd.init();
  lcd.backlight(); // เปิดไฟส่องสว่างด้านหลังจอ

  // พิมพ์ข้อความในบรรทัดแรก (คอลัมน์ 0, แถว 0)
  lcd.setCursor(0, 0);
  lcd.print("PHYCOM EXAM TEST");

  // พิมพ์ข้อความในบรรทัดที่สอง (คอลัมน์ 0, แถว 1)
  lcd.setCursor(0, 1);
  lcd.print("LCD OK! Sec:");

  Serial.println("ข้อความถูกส่งไปยังหน้าจอแล้ว หากยังไม่เห็นตัวอักษรให้หมุนปรับปุ่มสีฟ้าหลังจอ");
}

void loop() {
  delay(1000);
  counter++;

  // อัปเดตตัวเลขวินาทีที่ตำแหน่งคอลัมน์ที่ 12 แถวที่ 1
  lcd.setCursor(12, 1);
  lcd.print("    "); // ล้างค่าตัวเลขเก่า
  lcd.setCursor(12, 1);
  lcd.print(counter);

  Serial.print("จอ LCD ทำงานปกติ | เวลาทำงาน: ");
  Serial.print(counter);
  Serial.println(" วินาที");
}
