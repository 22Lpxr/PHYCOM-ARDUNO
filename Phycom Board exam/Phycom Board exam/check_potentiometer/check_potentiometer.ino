/*
  =============================================================================
  [PHYCOM EXAM] 2. โค้ดตรวจสอบตัวต้านทานปรับค่าได้ (Potentiometer)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  1. ตัวต้านทานปรับค่าได้ (แบบ Rotary มีก้านหมุน) มีขาทั้งหมด 3 ขา
  2. การต่อสายเข้าบอร์ด Arduino:
       - ขาริมข้างที่ 1 (ซ้าย) ---> ต่อเข้าช่อง 5V บนบอร์ด Arduino
       - ขากลาง (Wiper)       ---> ต่อเข้าช่อง A1 (Analog In) บนบอร์ด Arduino
       - ขาริมข้างที่ 2 (ขวา)  ---> ต่อเข้าช่อง GND บนบอร์ด Arduino

  💡 ทริคและข้อสังเกต:
  -----------------------------------------------------------------------------
  - ขาริม 2 ข้างสามารถสลับที่ระหว่าง 5V กับ GND ได้ (สลับแล้วจะแค่กลับทิศทางการหมุนตามเข็ม/ทวนเข็ม)
  - แต่ **"ขากลาง" ต้องต่อเข้า A1 เสมอ** ห้ามนำขากลางไปต่อ 5V หรือ GND เด็ดขาด

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. กด Upload โค้ดลงบอร์ด Arduino Uno R4 WiFi
  2. เปิด Serial Monitor ตั้ง Baud Rate เป็น 9600
  3. หมุนก้านปรับค่า:
       - เมื่อหมุนสุดข้างหนึ่ง ค่า Raw ต้องอ่านได้ 0 (0.00 V / 0%)
       - เมื่อหมุนสุดอีกข้างหนึ่ง ค่า Raw ต้องอ่านได้ 1023 (5.00 V / 100%)
       - ขณะหมุนไปมา ค่าตัวเลขต้องเพิ่มขึ้น-ลดลงอย่างต่อเนื่อง นุ่มนวล ไม่กระโดดมั่ว
  4. หากค่ากระโดดไปมาตลอดเวลาโดยที่ไม่ได้หมุน:
       - แสดงว่าสายขากลางหลวม หรือเสียบไม่แน่นกับ Breadboard
  =============================================================================
*/

const int potPin = A1;

void setup() {
  Serial.begin(9600);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("   Rotary Potentiometer Diagnostic Test   ");
  Serial.println("==========================================");
}

void loop() {
  // อ่านค่าสัญญาณ Analog จาก A1 (ค่า 0 ถึง 1023)
  int sensorValue = analogRead(potPin);

  // คำนวณเป็นแรงดันไฟฟ้า (0 - 5.0V)
  float voltage = sensorValue * (5.0 / 1023.0);

  // แปลงค่าเป็นเปอร์เซ็นต์ (0 - 100%)
  int percent = map(sensorValue, 0, 1023, 0, 100);

  // แสดงผลลัพธ์ออกทาง Serial Monitor
  Serial.print("Raw: ");
  Serial.print(sensorValue);
  Serial.print(" / 1023 | Voltage: ");
  Serial.print(voltage, 2);
  Serial.print(" V | Percent: ");
  Serial.print(percent);
  Serial.println(" %");

  delay(300); // อัปเดตทุกๆ 300 มิลลิวินาทีเพื่อให้เห็นการเปลี่ยนแปลงทันทีที่หมุน
}
