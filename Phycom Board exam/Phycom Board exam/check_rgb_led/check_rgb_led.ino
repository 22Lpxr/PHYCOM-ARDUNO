/*
  =============================================================================
  [PHYCOM EXAM] 5. โค้ดตรวจสอบหลอดไฟ LED หลายสี (RGB LED - Common Cathode)
  =============================================================================

  📖 คำแนะนำการต่อสาย (Wiring Instructions):
  -----------------------------------------------------------------------------
  หยิบหลอด RGB LED ขึ้นมาดูความยาวของขาทั้ง 4 ขา (เรียงจากขาที่ 1 ไป 4):
    - ขา 1 (Red - สีแดง):      ต่อผ่าน "ตัวต้านทาน 330 โอห์ม" ---> เข้าช่อง Pin 3 (PWM)
    - ขา 2 (Cathode - ขายาวสุด): ต่อตรงเข้าช่อง GND บนบอร์ด Arduino
    - ขา 3 (Green - สีเขียว):  ต่อผ่าน "ตัวต้านทาน 330 โอห์ม" ---> เข้าช่อง Pin 5 (PWM)
    - ขา 4 (Blue - สีน้ำเงิน):   ต่อผ่าน "ตัวต้านทาน 330 โอห์ม" ---> เข้าช่อง Pin 6 (PWM)

  ⚠️ ข้อควรระวัง (Crucial Warning):
  -----------------------------------------------------------------------------
  - **ต้องมีตัวต้านทานขนาด 330 โอห์ม** คั่นระหว่างขาขาสัญญาณ (R, G, B) กับบอร์ด Arduino เสมอ!
    ห้ามต่อตรงเข้า Pin ดิจิทัลโดยไม่มีตัวต้านทาน เพราะจะทำให้กระแสเกิน หลอด LED ขาด หรือขาไมโครคอนโทรลเลอร์เสียหายได้
  - หากหลอดของคุณเป็นแบบ Common Anode (ขาร่วมไฟบวก) ให้ต่อขา 2 เข้า 5V และสลับค่า 255 กับ 0 ในโค้ด

  🔍 วิธีทดสอบและตรวจสอบผลลัพธ์ (How to Test & Expected Output):
  -----------------------------------------------------------------------------
  1. กด Upload โค้ดลงบอร์ด Arduino
  2. เปิด Serial Monitor ตั้ง Baud Rate เป็น 9600
  3. สังเกตแสงไฟที่หลอด RGB LED:
       - วินาทีที่ 1: ติด "สีแดง" (RED)
       - วินาทีที่ 2: ติด "สีเขียว" (GREEN)
       - วินาทีที่ 3: ติด "สีน้ำเงิน/ฟ้า" (BLUE)
       - วินาทีที่ 4: ติด "สีขาว" (WHITE - แดง+เขียว+น้ำเงิน สว่างพร้อมกัน)
       - วินาทีที่ 5: "ดับสนิท" (OFF)
       - จากนั้นวนกลับมาเริ่มใหม่
  4. หากสีใดสีหนึ่งไม่ติด:
       - เช็คขาของสีนั้นและเช็คตัวต้านทานว่าเสียบแน่นลง Breadboard หรือไม่
  =============================================================================
*/

const int redPin = 3;
const int greenPin = 5;
const int bluePin = 6;

// ฟังก์ชันสำหรับกำหนดความสว่างของแต่ละแม่สี (ค่า 0 - 255)
void setColor(int r, int g, int b) {
  analogWrite(redPin, r);
  analogWrite(greenPin, g);
  analogWrite(bluePin, b);
}

void setup() {
  Serial.begin(9600);
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
  delay(1000);
  Serial.println("==========================================");
  Serial.println("        RGB LED Diagnostic Test           ");
  Serial.println("==========================================");
}

void loop() {
  Serial.println("Testing Color: [ RED ] (สีแดง)");
  setColor(255, 0, 0);
  delay(1000);

  Serial.println("Testing Color: [ GREEN ] (สีเขียว)");
  setColor(0, 255, 0);
  delay(1000);

  Serial.println("Testing Color: [ BLUE ] (สีน้ำเงิน)");
  setColor(0, 0, 255);
  delay(1000);

  Serial.println("Testing Color: [ WHITE ] (สีขาว - ผสมทุกสี)");
  setColor(255, 255, 255);
  delay(1000);

  Serial.println("Testing Color: [ OFF ] (ดับไฟ)");
  setColor(0, 0, 0);
  delay(1000);
}
